  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@emotion/react": "^11.13.5",
    "@emotion/styled": "^11.13.5",
    "@iconify/react": "^5.0.2",
    "@mui/icons-material": "^6.1.8",
    "@mui/material": "^6.1.8",
    "@react-oauth/google": "^0.12.1",
    "@reduxjs/toolkit": "^2.5.0",
    "@turf/turf": "^7.1.0",
    "mapbox-gl": "^3.8.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.4.1",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.9.6",
    "react-toastify": "^11.0.2",
    "redux": "^5.0.1"
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "node ./node_modules/eslint/bin/eslint.js --fix",
      "prettier --write"
    ],
    "*.{ts,tsx,css,json,md}": [
      "prettier --write"
    ]
  },
  "scripts": {
    "start": "vite --host 0.0.0.0 --port 3000",
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "lint": "node ./node_modules/eslint/bin/eslint.js \"src/**/*.{js,jsx}\"",
    "preview": "vite preview --host 0.0.0.0",
    "test": "echo \"No frontend tests configured\"",
    "prepare": "test \"$NODE_ENV\" = development && husky install || exit 0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@emnapi/core": "^1.10.0",
    "@emnapi/runtime": "^1.10.0",
    "@iconify/tailwind": "^1.1.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.22",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "husky": "^8.0.0",
    "lint-staged": "^15.2.11",
    "postcss": "^8.5.6",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.15",
    "typescript": "^4.9.5",
    "vite": "^8.0.10"
  }
