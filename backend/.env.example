NODE_ENV=development
PORT=5005

# Frontend URLs allowed by CORS. In production, use your Vercel URL without a trailing slash.
CLIENT_ORIGINS=http://localhost:3000,http://localhost:3001
FRONTEND_URL=http://localhost:3000

# Auth
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_EXPIRES_IN=2h
PASSWORD_RESET_EXPIRES_MINUTES=30

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ParkingApp
DB_CONNECTION_LIMIT=10
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# External APIs
MAPBOX_ACCESS_TOKEN=
OPEN_CHARGE_MAP_API_KEY=
GOOGLE_CLIENT_ID=

# Optional email delivery. Leave empty locally to use devResetUrl.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
